# ── Database ──────────────────────────────────────────────────────────────
# PostgreSQL connection string. Neon (https://neon.tech) is recommended —
# create a free project and copy the "Pooled connection" string here.
# Prisma needs sslmode=require for most hosted Postgres providers.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Neon also gives you a *direct* (non-pooled) connection string, useful if
# you later add a `directUrl` to prisma/schema.prisma for migrations.
# DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── Auth / Sessions ──────────────────────────────────────────────────────
# Random string used to sign admin session JWTs. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string-min-32-chars"

# ── Site ─────────────────────────────────────────────────────────────────
# Public URL of the deployed site (used for SEO metadata, sitemap, OG tags).
NEXT_PUBLIC_SITE_URL="https://mountainrideooty.com"

# ── Seed script (optional) ──────────────────────────────────────────────
# Used only by `npm run db:seed` to create the first admin login.
# Change the password immediately after your first login.
SEED_ADMIN_EMAIL="admin@mountainrideooty.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# ── Email notifications (optional) ──────────────────────────────────────
# Uncomment and fill these in, then follow the instructions in
# src/lib/notifications.ts to enable booking notification emails.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="your-smtp-username"
# SMTP_PASS="your-smtp-password"
# NOTIFY_TO_EMAIL="owner@mountainrideooty.com"
