generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(ADMIN)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Booking {
  id              String        @id @default(cuid())
  referenceId     String        @unique
  fullName        String
  mobileNumber    String
  whatsappNumber  String?
  travelDate      DateTime
  pickupLocation  String
  dropLocation    String?
  passengers      Int
  vehicleRequired String
  serviceRequired ServiceType
  message         String?
  status          BookingStatus @default(NEW)
  internalNotes   String?
  source          String        @default("website")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([travelDate])
  @@index([createdAt])
}

model Vehicle {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  capacityLabel String
  idealUsage    String
  description   String
  imageUrl      String?
  isAvailable   Boolean  @default(true)
  isPublished   Boolean  @default(true)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Service {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  description  String
  icon         String?
  ctaLabel     String   @default("Book Now")
  ctaHref      String   @default("/booking")
  isPublished  Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TourPackage {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  description   String
  attractions   String
  durationLabel String?
  startingPrice Int?
  imageUrl      String?
  isPublished   Boolean  @default(true)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SightseeingPlace {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String
  imageUrl     String?
  stampLabel   String?
  isPublished  Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Review {
  id           String   @id @default(cuid())
  customerName String
  rating       Int
  reviewText   String
  isApproved   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model GalleryImage {
  id           String   @id @default(cuid())
  imageUrl     String
  caption      String?
  category     String?
  isPublished  Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
}

model ContactEnquiry {
  id        String   @id @default(cuid())
  name      String
  mobile    String
  email     String?
  message   String
  isHandled Boolean  @default(false)
  createdAt DateTime @default(now())
}

model FaqItem {
  id           String  @id @default(cuid())
  question     String
  answer       String
  displayOrder Int     @default(0)
  isPublished  Boolean @default(true)
}

model SiteSettings {
  id              String   @id @default("singleton")
  businessName    String   @default("Mountain Ride Ooty")
  tagline         String   @default("Ride the Hills. Discover the Beauty.")
  phonePrimary    String   @default("9585943681")
  phoneSecondary  String   @default("8667803054")
  whatsappPrimary String   @default("9585943681")
  email           String?
  location        String   @default("Ooty, Tamil Nadu")
  businessHours   String   @default("Available for bookings every day.")
  facebookUrl     String?
  instagramUrl    String?
  logoUrl         String?
  heroImageUrl    String?
  primaryCtaText  String   @default("Book Your Ride")
  updatedAt       DateTime @updatedAt
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

enum BookingStatus {
  NEW
  CONTACTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ServiceType {
  OOTY_SIGHTSEEING
  AIRPORT_TRANSFER
  ONE_WAY
  ROUND_TRIP
  OUTSTATION
  CUSTOM_PACKAGE
}
